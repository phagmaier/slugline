# Rust build output. `app/` and `spike/` carry their own Flutter .gitignore.
/target/

# Fuzzing. The targets and their seed corpus are committed; build output,
# generated corpus entries and crash artefacts are not.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Release artefacts: tools/package.sh and tools/make_appimage.sh write here.
# The recipes are committed; what they produce is not.
/dist/

# Local tooling
.direnv/

# AUR: makepkg build artefacts. The PKGBUILD and .SRCINFO are committed;
# what makepkg downloads and produces is not.
/packaging/aur/*/pkg/
/packaging/aur/*/src/
/packaging/aur/*/*.tar.*
/packaging/aur/*/*.pkg.tar.*
/packaging/aur/*/dist/
