# Maintainer: Parker Hagmaier

pkgname=slugline-bin
pkgver=1.0.2
pkgrel=1
pkgdesc='Fast, keyboard-driven Fountain screenplay editor'
arch=('x86_64')
url='https://github.com/phagmaier/slugline'
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=(
  'at-spi2-core'
  'bash'
  'cairo'
  'fontconfig'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'harfbuzz'
  'hicolor-icon-theme'
  'libgcc'
  'libepoxy'
  'libstdc++'
  'pango'
  'zlib'
)
provides=('slugline')
conflicts=('slugline')
options=('!strip' '!debug')
_release_asset="slugline-${pkgver}-linux-${CARCH}.tar.gz"
source_x86_64=(
  "https://github.com/phagmaier/slugline/releases/download/v${pkgver}/${_release_asset}"
  "https://github.com/phagmaier/slugline/releases/download/v${pkgver}/SHA256SUMS"
)
# SHA256SUMS is generated beside the release asset after all release gates pass.
# prepare() requires and checks the tarball's exact entry. The two files share a
# versioned release URL; no network access occurs after makepkg's normal
# source-download phase.
sha256sums_x86_64=('SKIP' 'SKIP')

prepare() {
  local expected
  expected="$(
    awk -v asset="${_release_asset}" '$2 == asset { print $1 }' \
      "${srcdir}/SHA256SUMS"
  )"
  if [[ ! "${expected}" =~ ^[[:xdigit:]]{64}$ ]]; then
    printf 'No valid SHA-256 entry for %s in SHA256SUMS\n' \
      "${_release_asset}" >&2
    return 1
  fi
  printf '%s  %s\n' "${expected}" "${srcdir}/${_release_asset}" |
    sha256sum -c -
}

package() {
  local upstream="${srcdir}/slugline-${pkgver}-linux-${CARCH}"

  install -d "${pkgdir}/usr/lib/slugline"
  cp -r "${upstream}/bundle/." "${pkgdir}/usr/lib/slugline/"

  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/slugline" <<'EOF'
#!/bin/sh
set -eu
exec /usr/lib/slugline/slugline "$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/slugline"

  install -Dm644 \
    "${upstream}/share/applications/com.phagmaier.slugline.desktop" \
    "${pkgdir}/usr/share/applications/com.phagmaier.slugline.desktop"
  install -Dm644 \
    "${upstream}/share/metainfo/com.phagmaier.slugline.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/com.phagmaier.slugline.metainfo.xml"
  install -Dm644 \
    "${upstream}/share/mime/packages/com.phagmaier.slugline.xml" \
    "${pkgdir}/usr/share/mime/packages/com.phagmaier.slugline.xml"
  install -Dm644 \
    "${upstream}/share/icons/hicolor/scalable/apps/com.phagmaier.slugline.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/com.phagmaier.slugline.svg"

  install -Dm644 \
    "${upstream}/share/licenses/slugline/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 \
    "${upstream}/share/licenses/slugline/OFL-CourierPrime.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/OFL-CourierPrime.txt"
  install -Dm644 \
    "${upstream}/share/doc/slugline/CHANGELOG.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
  install -Dm644 \
    "${upstream}/share/doc/slugline/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
